<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RouteBench Report — {{ fleet_metrics.total_routes }} Routes</title>
  <style>{{ css }}</style>
</head>
<body>
  <div class="header">
    <h1>RouteBench Analysis Report</h1>
    <p class="subtitle">
      {{ fleet_metrics.total_routes }} routes · {{ fleet_metrics.total_stops }} stops ·
      {{ "%.1f"|format(fleet_metrics.total_distance_miles) }} miles total
    </p>
  </div>

  {% include "executive_summary.html.j2" %}

  {# Fleet overview #}
  <div class="section" id="fleet-overview">
    <h2>Fleet Overview</h2>
    {% if prose.get('fleet_overview_narrative') %}
    <div class="prose">{{ prose['fleet_overview_narrative'] }}</div>
    {% endif %}

    <table class="metrics-table">
      <thead>
        <tr>
          <th>Metric</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Total Routes</td><td>{{ fleet_metrics.total_routes }}</td></tr>
        <tr><td>Total Stops</td><td>{{ fleet_metrics.total_stops }}</td></tr>
        <tr><td>Total Distance</td><td>{{ "%.1f"|format(fleet_metrics.total_distance_miles) }} mi</td></tr>
        <tr><td>Total Time</td><td>{{ "%.1f"|format(fleet_metrics.total_time_hours) }} hr</td></tr>
        <tr><td>Routes Over Shift Cap</td><td>{{ fleet_metrics.routes_over_shift_cap }}</td></tr>
        {% if fleet_metrics.median_sequencing_index is not none %}
        <tr><td>Median Sequencing Index</td><td>{{ "%.2f"|format(fleet_metrics.median_sequencing_index) }}</td></tr>
        {% endif %}
      </tbody>
    </table>

    {# Route metrics table #}
    {% if route_metrics %}
    <h3>Per-Route Metrics</h3>
    <table class="metrics-table">
      <thead>
        <tr>
          <th>Route</th>
          <th>Stops</th>
          <th>Distance (mi)</th>
          <th>Time (hr)</th>
          <th>Stops/hr</th>
          <th>TW Violations</th>
          <th>Shift Overrun (min)</th>
        </tr>
      </thead>
      <tbody>
        {% for rid, rm in route_metrics.items() %}
        <tr>
          <td>{{ rm.route_id }}</td>
          <td>{{ rm.stop_count }}</td>
          <td>{{ "%.1f"|format(rm.total_distance_miles) }}</td>
          <td>{{ "%.1f"|format(rm.total_time_hours) }}</td>
          <td>{{ "%.1f"|format(rm.stops_per_hour) }}</td>
          <td>{{ rm.time_window_violations }}</td>
          <td>{{ "%.0f"|format(rm.shift_overrun_minutes) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {# Charts #}
    {% if charts.time_distribution %}
    <div class="chart-container">{{ charts.time_distribution }}</div>
    {% endif %}
    {% if charts.sequencing_index %}
    <div class="chart-container">{{ charts.sequencing_index }}</div>
    {% endif %}
    {% if charts.capacity_utilization %}
    <div class="chart-container">{{ charts.capacity_utilization }}</div>
    {% endif %}
  </div>

  {% include "per_route.html.j2" %}

  {% include "cross_fleet.html.j2" %}

  {% include "benchmark.html.j2" %}

  {# Investigation priorities #}
  <div class="section" id="investigation-priorities">
    <h2>Investigation Priorities</h2>
    {% if prose.get('investigation_priorities') %}
    <div class="prose">{{ prose['investigation_priorities'] }}</div>
    {% endif %}
  </div>

  {% include "methodology.html.j2" %}

  {# Caveats #}
  <div class="section" id="caveats">
    <h2>Caveats</h2>
    <div class="methodology">
      {% set traffic = metadata.get('traffic_profile', {}) if metadata else {} %}
      {% if traffic.get('active') %}
      <p>This analysis is based on planned route data. Travel times are free-flow estimates
      scaled by the configured traffic profile (see Methodology), which approximates recurring
      time-of-day congestion but is not live or historical traffic data. Weather and access
      restrictions are not modeled. Time window compliance is assessed against planned
      windows.</p>
      {% else %}
      <p>This analysis is based on planned route data and haversine distance estimates.
      Actual road distances and drive times may vary. Time window compliance is assessed
      against planned windows; real-world conditions (traffic, weather, access restrictions)
      are not modeled.</p>
      {% endif %}
      <p>Benchmark comparisons use OR-Tools with configurable time limits; solutions may
      not be globally optimal. Sequencing improvements are theoretical and assume no
      additional operational constraints beyond those specified in the input data.</p>
    </div>
  </div>

  {# Prose verification footer #}
  {% if verification %}
  <div class="section" id="verification">
    <h2>Prose Verification</h2>
    <div class="methodology">
      <p>Every narrative claim in this report is checked against the structured findings it
      came from. Of {{ verification.total }} prose section{{ '' if verification.total == 1 else 's' }}:
      <strong>{{ verification.counts.verified }} verified</strong>{% if verification.counts.regenerated %},
      <strong>{{ verification.counts.regenerated }} regenerated</strong> after a failed first
      check{% endif %}{% if verification.counts.fallback %},
      <strong>{{ verification.counts.fallback }} deterministic fallback</strong>{% endif %}.</p>

      {% if verification.counts.fallback %}
      <p>A <em>deterministic fallback</em> means generated prose failed verification twice, so
      the section was replaced with text built directly from the structured data. It is
      accurate, but it was not written by the model and reads plainly.</p>
      {% endif %}

      <table class="metrics-table">
        <thead><tr><th>Section</th><th>Status</th></tr></thead>
        <tbody>
          {% for slot in verification.slots %}
          <tr>
            <td>{{ slot.slot_id }}</td>
            <td>{{ slot.status }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}
</body>
</html>
