{# Benchmark comparison section #}
{% if benchmark %}
<div class="section" id="benchmark-comparison">
  <h2>Benchmark Comparison</h2>

  <p class="methodology">Each plan is compared against the best solution the solver found
  within its time limit. These are not proven optima, so a gap is a <em>lower bound</em> on
  what better sequencing could save. Where the solver found nothing better, the plan is
  reported as within solver reach rather than as a zero gap.</p>

  {% if benchmark.per_route %}
  <table class="metrics-table">
    <thead>
      <tr>
        <th>Route</th>
        <th>Planned Distance (mi)</th>
        <th>Solver Best (mi)</th>
        <th>Distance Savings (%)</th>
        <th>Planned Time (hr)</th>
        <th>Solver Best (hr)</th>
        <th>Time Savings (%)</th>
      </tr>
    </thead>
    <tbody>
      {% for rid, rb in benchmark.per_route.items() %}
      <tr>
        <td>{{ rb.route_id }}</td>
        <td>{{ "%.1f"|format(rb.actual_distance_miles) }}</td>
        <td>{{ "%.1f"|format(rb.optimal_distance_miles) }}</td>
        <td>
          {%- if rb.distance_gap_pct > 0 -%}
            {{ "%.1f"|format(rb.distance_gap_pct) }}%
          {%- else -%}
            none found
          {%- endif -%}
        </td>
        <td>{{ "%.1f"|format(rb.actual_time_hours) }}</td>
        <td>{{ "%.1f"|format(rb.optimal_time_hours) }}</td>
        <td>
          {%- if rb.time_gap_pct > 0 -%}
            {{ "%.1f"|format(rb.time_gap_pct) }}%
          {%- else -%}
            none found
          {%- endif -%}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if charts.benchmark_gap %}
  <div class="chart-container">{{ charts.benchmark_gap }}</div>
  {% endif %}

  {% if benchmark.fleet_level %}
  <h3>Fleet-Level Benchmark</h3>
  <table class="metrics-table">
    <thead><tr><th>Metric</th><th>Value</th></tr></thead>
    <tbody>
      <tr><td>Planned Total Distance</td><td>{{ "%.1f"|format(benchmark.fleet_level.actual_total_distance) }} mi</td></tr>
      <tr><td>Solver Best Total Distance</td><td>{{ "%.1f"|format(benchmark.fleet_level.optimal_total_distance) }} mi</td></tr>
      <tr>
        <td>Improvement Found</td>
        <td>
          {%- if benchmark.fleet_level.improvement_gap_pct > 0 -%}
            {{ "%.1f"|format(benchmark.fleet_level.improvement_gap_pct) }}%
          {%- else -%}
            none — plan is within solver reach
          {%- endif -%}
        </td>
      </tr>
      <tr><td>Stop Migrations</td><td>{{ benchmark.fleet_level.stop_migrations | length }}</td></tr>
    </tbody>
  </table>
  {% endif %}
</div>
{% endif %}
