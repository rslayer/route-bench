{# Per-route findings section #}
<div class="section" id="per-route-findings">
  <h2>Per-Route Findings</h2>

  {% set severity_order = {'critical': 0, 'high': 1, 'medium': 2, 'low': 3, 'info': 4} %}
  {% set high_findings = findings | selectattr('severity', 'in', ['critical', 'high', 'medium']) | list %}
  {% set low_findings = findings | selectattr('severity', 'in', ['low', 'info']) | list %}

  {% for finding in high_findings %}
  {% include 'partials/finding_card.html.j2' %}
  {% endfor %}

  {% if low_findings %}
  <div class="appendix">
    <details>
      <summary>{{ low_findings | length }} low-severity / informational findings</summary>
      {% for finding in low_findings %}
      {% include 'partials/finding_card.html.j2' %}
      {% endfor %}
    </details>
  </div>
  {% endif %}
</div>
