# Core
# ANTHROPIC_API_KEY is optional. Without it the analysis still runs end to end
# — all analyzers, findings, benchmark and grade — with templated prose instead
# of written narrative. See "LLM-optional" in the README.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
LOG_LEVEL=INFO

# Matrix engine: "osrm" (default, self-hosted, free-flow, no per-request cost)
# or "google" (Google Routes computeRouteMatrix, live traffic, BILLS PER
# ELEMENT). Leave as osrm unless you have set GOOGLE_MAPS_API_KEY and accept the
# cost — a single fleet benchmark is (stops+depot)^2 elements at ~$0.01 each.
MATRIX_ENGINE=osrm

# Google Routes API key, used only when MATRIX_ENGINE=google. A billable
# credential — set it here as a deployment secret; it is never entered in the
# web UI or stored per-upload.
GOOGLE_MAPS_API_KEY=

# Routing engine. Without a reachable OSRM, travel times degrade to straight-line
# estimates and the quality grade is withheld. See "OSRM Setup" in the README.
OSRM_HOST=http://localhost:5000
# Written by scripts/bootstrap_osrm.sh; read by docker-compose to locate the graph.
OSRM_REGION=texas-latest

# Matrix cache. Keyed by coordinates, so entries only go stale if the road
# network itself changes. Wraps OSRM only — estimates are never cached, so an
# OSRM outage cannot poison it.
MATRIX_CACHE_ENABLED=true
# Path defaults to <repo>/data/matrix-cache, anchored to the repo rather than
# the working directory, so it does not depend on where the process is launched
# from. Uncomment to override — use an absolute path on a persistent volume in
# production. A relative value here is resolved against the launch cwd.
# MATRIX_CACHE_PATH=/var/lib/routebench/matrix-cache

# Storage (local or s3)
STORAGE_BACKEND=local
# Path defaults to <repo>/data/sessions, anchored to the repo (see above).
# Uncomment to override; docker sets this to /data/sessions.
# STORAGE_PATH=/data/sessions

# S3/R2 (only needed when STORAGE_BACKEND=s3)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=routebench
R2_REGION=auto

# Worker
MAX_QUEUE_DEPTH=5
JOB_TIMEOUT_SECONDS=600

# Retention
SESSION_TTL_HOURS=72
TELEMETRY_TTL_HOURS=720

# Cost
DAILY_BUDGET_USD=50.0
MAX_INPUT_TOKENS_PER_SESSION=500000
# Daily cap on matrix-engine spend (Google bills per element). 0 = off. Once the
# day's estimated matrix spend reaches this, runs fall back to haversine
# estimates (grade withheld) instead of billing more; resets at UTC midnight.
DAILY_MATRIX_BUDGET_USD=0.0

# Admin
ADMIN_TOKEN=

# Observability
SENTRY_DSN=
