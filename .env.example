# Core
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-7
OSRM_HOST=http://localhost:5000
LOG_LEVEL=INFO

# Storage (local or s3)
STORAGE_BACKEND=local
STORAGE_PATH=./data/sessions

# S3/R2 (only needed when STORAGE_BACKEND=s3)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=routebench
R2_REGION=auto

# Worker
MAX_QUEUE_DEPTH=5
JOB_TIMEOUT_SECONDS=600

# Retention
SESSION_TTL_HOURS=72
TELEMETRY_TTL_HOURS=720

# Cost
DAILY_BUDGET_USD=50.0
MAX_INPUT_TOKENS_PER_SESSION=500000

# Admin
ADMIN_TOKEN=

# Observability
SENTRY_DSN=
